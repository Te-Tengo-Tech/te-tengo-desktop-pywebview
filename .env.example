# Copia este archivo como .env y completa los valores. Nunca subas .env al repositorio.

TT_ENTORNO=local
TT_NIVEL_LOG=INFO

# Token que presenta el Agente de captura al abrir el WebSocket de ingesta.
TT_INGESTA_TOKEN=

# Backend API del sistema (Spring Boot).
TT_BACKEND_URL=http://localhost:8080
TT_BACKEND_TOKEN=

# Modelo de MediaPipe (make modelo).
TT_MODELO_POSE_RUTA=models/pose_landmarker_lite.task

# Almacenamiento de clips. En local, SeaweedFS expone una API compatible con S3.
TT_CLIPS_BUCKET=te-tengo-clips
TT_AWS_REGION=us-east-1
TT_S3_ENDPOINT_URL=http://localhost:8333

# Clasificación cinemática (docs/especificacion-clasificacion.md).
# Sin valor por defecto: se calibra con pruebas (longitudes de línea central por segundo).
TT_CLASIFICACION__VELOCIDAD_DESCENSO_MIN=
# Valores de Chen et al. (2020) y del product backlog; cámbialos solo tras calibrar.
TT_CLASIFICACION__ANGULO_LINEA_CENTRAL_MAX_GRADOS=45
TT_CLASIFICACION__RAZON_ANCHO_ALTO_MIN=1
TT_CLASIFICACION__INTERVALO_VELOCIDAD_S=0.25
TT_CLASIFICACION__VENTANA_REACCION_S=1.48
TT_CLASIFICACION__CONFIRMACION_SUELO_S=30
TT_CLASIFICACION__SIN_DETECCION_CONFIABLE_S=300
TT_CLASIFICACION__VISIBILIDAD_MIN=0.5
