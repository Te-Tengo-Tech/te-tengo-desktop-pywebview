# Copy this file to .env and fill in the values. Never push .env to the repository.

TT_ENTORNO=local
TT_NIVEL_LOG=INFO

# Token that the Capture Agent presents when it opens the ingestion WebSocket.
TT_INGESTA_TOKEN=

# The system's Backend API (Spring Boot).
TT_BACKEND_URL=http://localhost:8080
TT_BACKEND_TOKEN=

# MediaPipe model (make modelo).
TT_MODELO_POSE_RUTA=models/pose_landmarker_lite.task

# Clip storage. Locally, SeaweedFS exposes an S3-compatible API.
TT_CLIPS_BUCKET=te-tengo-clips
TT_AWS_REGION=us-east-1
TT_S3_ENDPOINT_URL=http://localhost:8333

# Kinematic classification (docs/classification-spec.md).
# Calibrated with URFD and CAUCAFall (docs/validation.md, rule R1; bodies per second).
# If left empty, the service starts (/health, /docs) but rejects the ingestion video.
TT_CLASIFICACION__VELOCIDAD_DESCENSO_MIN=0.01
# Values from Chen et al. (2020) and the product backlog; change them only after calibrating.
TT_CLASIFICACION__ANGULO_LINEA_CENTRAL_MAX_GRADOS=45
TT_CLASIFICACION__RAZON_ANCHO_ALTO_MIN=1
TT_CLASIFICACION__INTERVALO_VELOCIDAD_S=0.25
TT_CLASIFICACION__VENTANA_VELOCIDAD_S=1.0
TT_CLASIFICACION__VENTANA_REACCION_S=1.48
TT_CLASIFICACION__CONFIRMACION_SUELO_S=30
TT_CLASIFICACION__PERSISTENCIA_ERGUIDO_S=1.0
TT_CLASIFICACION__SIN_DETECCION_CONFIABLE_S=300
TT_CLASIFICACION__VISIBILIDAD_MIN=0.5
